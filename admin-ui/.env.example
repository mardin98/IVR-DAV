# GCP
GCP_PROJECT_ID=tu-proyecto-id

# Vertex AI Search — crear en GCP Console → Vertex AI → Search & Conversation
VERTEX_SEARCH_DATASTORE_ID=callmanager-kb_1234567890

# Cloud Storage — bucket para documentos subidos
KB_BUCKET_NAME=tu-proyecto-id-kb-documents

# Firebase Admin (para autenticación server-side si se necesita)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
