# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Variables de entorno del Orchestrator
# Copiar a .env y completar los valores reales
# En producción (Cloud Run) usar Secret Manager, no este archivo
# ═══════════════════════════════════════════════════════════════════════════════

# ── GCP ────────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=tu-proyecto-gcp-id

# ── Gemini ─────────────────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── FreeSWITCH ESL ─────────────────────────────────────────────────────────────
# IP de la VM on-premise donde corre FreeSWITCH
FREESWITCH_HOST=192.168.1.100
FREESWITCH_ESL_PORT=8021
# Password definido en /etc/freeswitch/autoload_configs/event_socket.conf.xml
FREESWITCH_ESL_PASSWORD=ClueCon

# ── Helpdesk interno ────────────────────────────────────────────────────────────
HELPDESK_BASE_URL=http://helpdesk.davivienda.internal/api/v1
HELPDESK_API_KEY=tu-api-key-helpdesk

# ── Pub/Sub ─────────────────────────────────────────────────────────────────────
PUBSUB_ESCALATION_TOPIC=call-escalations

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
